---
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StreamPlayer from '../components/StreamPlayer.astro';
import { SITE_TITLE, SLOGAN_PRIMARY } from '../consts';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logos/Logo Voces 4 mini.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quiénes Somos — {SITE_TITLE}</title>
    
  </head>
  <body>
    <Header currentPath="/about" />

    <div class="page-hero">
      <div class="container">
        <h1>Quiénes Somos</h1>
        <p>{SLOGAN_PRIMARY} — La Emisora Digital del Campo Colombiano.</p>
      </div>
    </div>

    <section class="section">
      <div class="container" style="max-width: 800px;">
        <h2 style="color: var(--green-900); margin-bottom: 1rem;">Nuestra Misión</h2>
        <p style="margin-bottom: 1.5rem; font-size: 1.05rem;">**{SITE_TITLE} (Voces Campesinas)** nace con el firme propósito de ser el puente de comunicación, cultura y desarrollo para las comunidades rurales de Colombia. Creemos en el valor de la tierra, la soberanía alimentaria, la paz territorial y la preservación de nuestras tradiciones musicales y campesinas.</p>

        <h2 style="color: var(--green-900); margin-bottom: 1rem; margin-top: 2rem;">Nuestra Emisora</h2>
        <p style="margin-bottom: 1.5rem; font-size: 1.05rem;">Transmitimos 24 horas al día desde la digitalidad para llegar a cada rincón donde haya un campesino, un productor agropecuario o un apasionado por el campo. A través de nuestra programación institucional, magazínes informativos, música andina y espacios colaborativos como la Red de Información Territorial (RIT), damos voz a quienes construyen país desde las regiones.</p>

        <h2 style="color: var(--green-900); margin-bottom: 1rem; margin-top: 2rem;">¿Qué nos mueve?</h2>
        <ul style="margin-left: 1.5rem; margin-bottom: 2rem; display: flex; flexDirection: column; gap: 0.75rem; font-size: 1.05rem;">
          <li>🌾 **El fortalecimiento del agro colombiano** y el apoyo a los productores locales.</li>
          <li>🕊️ **La construcción de paz** y tejido social desde las veredas y municipios.</li>
          <li>🎵 **La cultura andina y campesina** como identidad viva de nuestra nación.</li>
          <li>📻 **La innovación radial** conectando la radio tradicional con las nuevas plataformas digitales.</li>
        </ul>
      </div>
    </section>

    <Footer />
    <StreamPlayer />
  </body>
</html>