---
import { SITE_TITLE, SLOGAN_PRIMARY, SOCIAL, NAV_ITEMS } from '../consts';
---

<footer class="footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <h3>{SITE_TITLE}</h3>
      <p>{SLOGAN_PRIMARY} — {SITE_TITLE} es el portal de noticias y programación de Voces Campesinas, la emisora digital del campo colombiano.</p>
      <div class="footer-social">
        <a href={SOCIAL.facebook} target="_blank" rel="noopener" aria-label="Facebook">f</a>
        <a href={SOCIAL.instagram} target="_blank" rel="noopener" aria-label="Instagram">ig</a>
        <a href={SOCIAL.youtube} target="_blank" rel="noopener" aria-label="YouTube">yt</a>
        <a href={SOCIAL.tiktok} target="_blank" rel="noopener" aria-label="TikTok">tk</a>
      </div>
    </div>
    <div>
      <h4>Secciones</h4>
      <ul class="footer-links">
        {NAV_ITEMS.map(item => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Categorías</h4>
      <ul class="footer-links">
        <li><a href="/secciones/agricultura">Agricultura</a></li>
        <li><a href="/secciones/ganaderia">Ganadería</a></li>
        <li><a href="/secciones/deportes">Deportes</a></li>
        <li><a href="/secciones/medio-ambiente">Medio Ambiente</a></li>
        <li><a href="/secciones/rit">RIT</a></li>
      </ul>
    </div>
    <div>
      <h4>Contacto</h4>
      <ul class="footer-links">
        <li><a href="/contacto">Escríbenos</a></li>
        <li><a href="/about">Quiénes Somos</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {SITE_TITLE} — Voces Campesinas. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
  }
  .footer-links a {
    text-decoration: none;
  }
</style>